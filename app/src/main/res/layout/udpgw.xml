<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:paddingEnd="15dp"
    android:orientation="vertical"
    android:paddingBottom="10dp"
    android:paddingStart="15dp"
    android:paddingTop="10dp">

    <LinearLayout
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:orientation="horizontal">

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:textSize="18sp"
            android:layout_weight="1"
            android:text="Badvpn UDPGW"
            android:textStyle="bold" />

        <Button
            android:layout_height="30dp"
            android:layout_width="30dp"
            android:background="@drawable/ic_tutup"
            android:textSize="17sp"
            android:id="@+id/udpgw_cancel"
            android:layout_gravity="right"
            tools:ignore="RtlHardcoded" />

    </LinearLayout>

    <View
        android:layout_height="1dp"
        android:layout_width="match_parent"
        android:background="?android:dividerVertical" />

    <LinearLayout
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:layout_marginTop="10dp"
        android:orientation="vertical">


        <com.google.android.material.textfield.TextInputLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:hint="UDPGW (7300)">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:singleLine="true"
                android:maxLines="1"
                android:id="@+id/fragment_udpgw" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="vertical">

            <Button
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:background="@drawable/my_btn_bg"
                android:textColor="@color/colorPrimaryBackground"
                android:id="@+id/udpgw_save"
                android:text="Apply" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
